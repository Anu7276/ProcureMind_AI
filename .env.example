# ─────────────────────────────────────────────
# BIS Standards Recommendation Engine — .env
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────
# Supported: google | openai | anthropic | groq | ollama
LLM_PROVIDER=google

# Google Gemini (default for this project)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (alternative — fast inference, free tier)
GROQ_API_KEY=your_groq_api_key_here

# Ollama (local/India-hosted model swap-in)
# Set LLM_PROVIDER=ollama and configure below:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Override the model name for any provider (optional)
# Defaults: google→gemini-1.5-flash, openai→gpt-4o-mini, anthropic→claude-3-haiku-20240307
LLM_MODEL_OVERRIDE=

# ── Embedding ─────────────────────────────────
# Supported: sentence-transformers | openai
EMBEDDING_MODEL=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# (384 dimensions; model is downloaded automatically on first run, ~90MB)

# ── PostgreSQL ────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://bis:bispassword@localhost:5432/bis_standards
POSTGRES_SYNC_URL=postgresql://bis:bispassword@localhost:5432/bis_standards
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bis_standards
POSTGRES_USER=bis
POSTGRES_PASSWORD=bispassword

# ── Neo4j ─────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bispassword

# ── Qdrant ────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_STANDARDS=standards_vectors
QDRANT_COLLECTION_FULLTEXT=standards_fulltext_chunks

# ── Data ──────────────────────────────────────
DATA_DIR=BIS_Sahayak_Clean_Data/clean

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Retrieval tuning ──────────────────────────
# Top-K candidates from Qdrant before graph expansion
RETRIEVE_TOP_K=10
# Max graph hops for Neo4j expansion
GRAPH_MAX_HOPS=2
